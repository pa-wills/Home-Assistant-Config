# Ignore everything by default, then whitelist what belongs in the repo.
*

!.gitignore
!*.md
!*.yaml
!*.yml
!requirements-ci.txt
!.github/
!.github/**
!appdaemon/
!appdaemon/**/
!appdaemon/apps/*.py
!www/
!www/*.jpg

# HA runtime state and credentials. Must never be committed.
.storage
.cloud
.google.token
ip_bans.yaml
secrets.yaml
known_devices.yaml
google_calendars.yaml
custom_components/
appdaemon/*.log
